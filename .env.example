# Base URL of the play-next-api Express API.
# Injected into the bundle at build time, so this file is only needed on the machine that runs
# `npm run build` - never deploy it to the web server, where nothing reads it.
# Behind nginx use the same-origin path instead of a host: VITE_API_BASE_URL=/api
# Anything in a VITE_ variable is readable by anyone who loads the page. Never put a secret here.
VITE_API_BASE_URL=http://localhost:3000
